node_modules/
lib/
*.tsbuildinfo

# Local pnpm package-store cache: never committed (tool artifact).
.pnpm-store/

# `pnpm run compat` installs each published DSH release here to boot the plugin
# against the real package. Cached between runs; never committed.
.compat/

# Local, non-committed screenshot sources. Generated (annotated) screenshots live
# directly under docs/images/; the raw screenshots that produce them are kept
# here and are not committed.
docs/images/source/

# Python bytecode from the font pipeline (`scripts/fonts`). A tool artifact; the
# scripts themselves are committed.
__pycache__/

# Scratch space for the throwaway scripts that carve a working tree into
# separate commits (a partial-stage helper). Not part of the project.
.tmp-hunks/
